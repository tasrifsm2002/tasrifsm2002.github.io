@mastersthesis{tasrif2026shno,
  abbr            = {B.Sc.},
  bibtex_show     = {true},
  title           = {Voltage Controlled High-Frequency Pulse Width Modulation Generation based on Spin Hall Nano-Oscillator},
  author          = {Tasrif, Md. Shahriyar Mahmud},
  school          = {Bangladesh University of Engineering and Technology (BUET)},
  additional_info = {. Undergraduate thesis; supervisor: Dr. Orchi Hassan, Dept. of EEE},
  year            = {2026},
  month           = jun,
  abstract        = {Conventional CMOS-only pulse width modulation (PWM) generators face fundamental performance ceilings in the GHz frequency regime: parasitic capacitance, unfavourable power scaling with frequency, and degraded timing resolution all arise from the physics of charge transport and cannot be resolved by process scaling alone. Yet high-frequency PWM signals in the GHz range are essential for advanced radio-frequency transmitters, neuromorphic computing engines, and miniaturised power converters intended for next-generation embedded systems. This thesis presents a compact, energy-efficient hybrid spintronic-CMOS PWM generator that addresses the GHz-range limitation by replacing the high-speed digital oscillator with a field-free Spin Hall Nano Oscillator (SHNO). The SHNO exploits spin-orbit torque to sustain natural GHz-range magnetization precession in a magnetic tunnel junction (MTJ) without an external magnetic field. The precessing magnetization modulates the MTJ resistance quasi-sinusoidally; this resistance variation is converted to a voltage signal through a resistive voltage divider, then digitised by a three-stage FinFET CMOS inverter chain to produce a rail-to-rail square-wave output. Two circuit architectures are designed, simulated, and compared in HSPICE. The primary architecture uses a single p-channel FinFET as the voltage-controlled series resistance in the divider network, realised as a 7T-1MTJ circuit, achieving 7.5 GHz oscillation frequency, a duty cycle tuning range of 6–95\%, and a total average power consumption below 50 µW. The oscillation frequency and duty cycle are fully decoupled: changing the gate-source voltage (V_SG) does not alter the oscillator frequency. The second architecture replaces the single pFET with a CMOS transmission gate — an nFET and pFET connected in parallel with complementary control signals. The parallel combination presents a much flatter on-resistance versus control-voltage characteristic, extending the effective duty cycle tuning range to 20–85\% with improved linearity (R² > 0.98) and approximately 4× lower control sensitivity (about 1.5\%/mV versus 6\%/mV). Power consumption remains in the same microwatt regime. All simulations use a macrospin LLGS-based MTJ model and Predictive Technology Model (PTM) FinFET cards. To the best of the author's knowledge, this is the first PWM generator that simultaneously achieves GHz-range oscillation frequency and sub-50 µW power consumption.}
}
